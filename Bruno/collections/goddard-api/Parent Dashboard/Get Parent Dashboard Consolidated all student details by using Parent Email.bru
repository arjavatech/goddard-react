meta {
  name: Get Parent Dashboard Consolidated all student details by using Parent Email
  type: http
  seq: 6
}

get {
  url: {{base_url}}/admission_child_personal/parent_email/{{school_id}}/{{email}}
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{auth_token}}
}

docs {
  ## Get Parent by Email
  
  Retrieves parent information and associated children by email.
  
  ### Path Parameters
  - `email` (string, required): Parent's email address
  
  ### Response
  Returns parent details including:
  - Parent personal information
  - List of children
  - Form completion status
  
  ### The API joins 8 tables
  - child_info
  - parent_info
  - form_repository
  - class_info
  - admission_form
  - enrollment_form
  - authorization form
  - parent handbook
}
