meta {
  name: Get Form Details by Child ID
  type: http
  seq: 1
}

get {
  url: {{base_url}}/child_all_form_details/{{school_id}}/{{child_id}}
  body: none
  auth: bearer
}

params:path {
  child_id: child_123
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{auth_token}}
}

docs {
  ## Get Form Details
  
  Retrieves all form data for a specific child.
  
  ### Path Parameters
  - `school_id` (number, required): School identifier
  - `child_id` (string, required): Child identifier
  
  ### Response
  Returns comprehensive form data including:
  - Admission form details
  - Authorization form data
  - Enrollment agreement
  - Parent handbook acknowledgments
  - Form completion status
  
  ### The API joins 8 tables  
  - child_info
  - parent_info
  - form_repository
  - class_info 
  - admission_form
  - enrollment_form
  - authorization form
  - parent handbook
}
