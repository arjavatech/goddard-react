meta {
  name: Get Class Details
  type: http
  seq: 1
}

get {
  url: {{base_url}}/class_details/{{school_id}}
  body: none
  auth: bearer
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

auth:bearer {
  token: {{auth_token}}
}

docs {
  ## Get Class Details
  
  Retrieves all class information for a school.
  
  ### Path Parameters
  - `school_id` (number, required): School identifier
  
  ### Response
  Returns array of classes with:
  - Class ID and name
  - Age group requirements
  - Teacher assignments
  - Capacity and current enrollment
  - Schedule information
}
