meta {
  name: Class based Child details Get
  type: http
  seq: 3
}

get {
  url: {{base_url}}/class_based_all_child_details/{{school_id}}/{{class_id}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
}

docs {
  ### The API joins 5 tables  
  - child_info
  - parent_info
  - student_form_repository
  - class_info 
  - admission_form
}
